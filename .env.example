# Copie para .env no ambiente local: cp .env.example .env
# Em produção (Render) estas variáveis vivem no painel do serviço.
# O .env nunca entra na imagem Docker (veja .dockerignore).

PORT=3005
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres
# true em qualquer Postgres gerenciado (Render, Neon, Supabase, Aiven...)
DB_SSL=false
# o schema vem das migrations; não ligue o synchronize
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

JWT_SECRET=troque-este-valor
JWT_EXPIRATION_TIME=604800

# Obrigatória: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Lista separada por vírgula. Se ausente, usa o fallback de src/main.ts.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# URL pública do backend. Se definida, um job chama <URL>/health a cada
# 10 minutos para a instância não hibernar. Deixe vazia localmente.
KEEP_ALIVE_URL=
