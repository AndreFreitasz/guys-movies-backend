# Copie para .env no ambiente local. Em produção (Koyeb), configure estas
# variáveis no painel do serviço — o .env NÃO vai para a imagem.

# A plataforma injeta PORT automaticamente; localmente cai no fallback 3005.
PORT=3005
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres
# true em qualquer Postgres gerenciado (Koyeb, Neon, Supabase, Aiven...)
DB_SSL=false
# false só depois que o projeto tiver migrations
DB_SYNCHRONIZE=true

JWT_SECRET=troque-este-valor
JWT_EXPIRATION_TIME=7200

TMDB_API_KEY=

# Lista separada por vírgula. Se ausente, usa localhost + o domínio da Vercel.
CORS_ORIGINS=http://localhost:3000,https://guys-movies-frontend.vercel.app
